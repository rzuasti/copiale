+fn secret_params(
+    master_key_bytes: &[u8],
+) -> Result<GroupSecretParams, ServiceError> {
+    let master_key = GroupMasterKey::new(
+        master_key_bytes
+            .try_into()
+            .map_err(|_| ServiceError::GroupsV2Error)?,
+    );
+    Ok(GroupSecretParams::derive_from_master_key(master_key))
+}
