From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ricardo Zuasti <rzuasti@pm.me>
Subject: [PATCH] feat: return the group refresh_group fetched

Manager::refresh_group returns the decrypted group, with what the store
doesn't keep, such as whether an admin ended it (`terminated`).

Assisted-by: Claude Opus 5.5
---
diff --git a/src/manager/registered.rs b/src/manager/registered.rs
index 34cf3c4..b1c948f 100644
--- a/src/manager/registered.rs
+++ b/src/manager/registered.rs
@@ -565,17 +565,21 @@ impl<S: Store> Manager<S, Registered> {
     }
 
     /// Fetches the group's state from the server and stores it, whatever
-    /// revision is stored.
-    pub async fn refresh_group(&self, master_key_bytes: &[u8]) -> Result<(), Error<S::Error>> {
+    /// revision is stored; returns it, with what the store doesn't keep,
+    /// such as whether the group was ended.
+    pub async fn refresh_group(
+        &self,
+        master_key_bytes: &[u8],
+    ) -> Result<libsignal_service::groups_v2::Group, Error<S::Error>> {
         let mut groups_manager = Box::pin(self.groups_manager()).await?;
         let encrypted_group = groups_manager
             .fetch_encrypted_group(&mut rand::rng(), master_key_bytes)
             .await?;
         let group = decrypt_group(master_key_bytes, encrypted_group)?;
         self.store
-            .save_group(master_key_bytes.try_into()?, group)
+            .save_group(master_key_bytes.try_into()?, group.clone())
             .await?;
-        Ok(())
+        Ok(group)
     }
 
     /// Authenticates against the storage service with the account's storage
