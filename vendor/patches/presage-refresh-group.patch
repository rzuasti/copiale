From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ricardo Zuasti <rzuasti@pm.me>
Date: Mon, 19 Oct 2026 23:50:00 -0400
Subject: [PATCH] feat: refresh a group from the server

Manager::refresh_group fetches and stores a group's state whatever
revision is stored, so clients can check a sender missing from the
stored state before dropping their message.

Assisted-by: Claude Opus 5.5
---
diff --git a/src/manager/registered.rs b/src/manager/registered.rs
index 94ca612..b334844 100644
--- a/src/manager/registered.rs
+++ b/src/manager/registered.rs
@@ -560,6 +560,20 @@ impl<S: Store> Manager<S, Registered> {
         Ok(Some(avatar))
     }
 
+    /// Fetches the group's state from the server and stores it, whatever
+    /// revision is stored.
+    pub async fn refresh_group(&self, master_key_bytes: &[u8]) -> Result<(), Error<S::Error>> {
+        let mut groups_manager = Box::pin(self.groups_manager()).await?;
+        let encrypted_group = groups_manager
+            .fetch_encrypted_group(&mut rand::rng(), master_key_bytes)
+            .await?;
+        let group = decrypt_group(master_key_bytes, encrypted_group)?;
+        self.store
+            .save_group(master_key_bytes.try_into()?, group)
+            .await?;
+        Ok(())
+    }
+
     async fn groups_manager(
         &self,
     ) -> Result<GroupsManager<InMemoryCredentialsCache>, Error<S::Error>> {
