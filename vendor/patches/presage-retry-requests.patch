 /// Set the timestamp in any DataMessage so it matches its envelope's
+/// A retry request ([`ContentBody::DecryptionErrorMessage`]) as
+/// [`Received::RetryRequest`]; `None` if it isn't for this device.
+///
+/// Archives our session with the requesting device if the request names its
+/// current ratchet key: the session is broken, so the next message starts a
+/// new one.
+async fn retry_request<S: Store>(
+    store: &S,
+    metadata: &Metadata,
+    request: &libsignal_service::proto::DecryptionErrorMessage,
+    device_id: DeviceId,
+) -> Option<Received> {
+    let Some(timestamp) = request.timestamp else {
+        warn!("retry request without a timestamp");
+        return None;
+    };
+    if request.device_id != Some(u32::from(device_id)) {
+        debug!("retry request for another of our devices");
+        return None;
+    }
+    let mut session_archived = false;
+    if let Some(ratchet_key) = &request.ratchet_key {
+        match archive_broken_session(store, metadata, ratchet_key).await {
+            Ok(archived) => session_archived = archived,
+            Err(error) => warn!(%error, "failed to check the session of a retry request"),
+        }
+    }
+    info!(timestamp, session_archived, "received a retry request");
+    Some(Received::RetryRequest {
+        sender: metadata.sender,
+        sender_device: metadata.sender_device,
+        timestamp,
+        session_archived,
+    })
+}
+
+/// Archives our session with the sender's device if its current ratchet key
+/// is `ratchet_key`; returns whether it did.
+async fn archive_broken_session<S: Store>(
+    store: &S,
+    metadata: &Metadata,
+    ratchet_key: &[u8],
+) -> Result<bool, libsignal_service::prelude::ServiceError> {
+    let ratchet_key = libsignal_service::protocol::PublicKey::deserialize(ratchet_key)?;
+    let address = metadata.sender.to_protocol_address(metadata.sender_device)?;
+    let mut sessions = store.aci_protocol_store();
+    let Some(mut session) = sessions.load_session(&address).await? else {
+        return Ok(false);
+    };
+    if !session.current_ratchet_key_matches(&ratchet_key)? {
+        return Ok(false);
+    }
+    session.archive_current_state()?;
+    sessions.store_session(&address, &session).await?;
+    Ok(true)
+}
