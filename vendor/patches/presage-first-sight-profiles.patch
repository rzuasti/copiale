         key: ProfileKey,
-    ) -> impl Future<Output = Result<Option<Profile>, Self::ContentsStoreError>>;
+    ) -> impl Future<Output = Result<Option<Profile>, Self::ContentsStoreError>> + Send;
 
     /// Save a profile avatar by [Uuid] and [ProfileKey].
     fn save_profile_avatar(
