-    ) -> impl Future<Output = Result<(), Self::ContentsStoreError>>;
+    ) -> impl Future<Output = Result<(), Self::ContentsStoreError>> + Send;
 
     /// Retrieve a profile by [Uuid] and [ProfileKey].
     fn profile(
         &self,
