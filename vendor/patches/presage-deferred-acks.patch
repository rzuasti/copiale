-                            return Some((Received::QueueEmpty, state));
+                            return Some(((Received::QueueEmpty, acknowledgement), state));
                         }
                         Some(Err(error)) => {
                             error!(%error, "unexpected error in message receiving loop")
@@ -1795,6 +1832,13 @@ impl<S: Store> Manager<S, Registered> {
