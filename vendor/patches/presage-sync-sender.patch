From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ricardo Zuasti <rzuasti@pm.me>
Date: Mon, 19 Oct 2026 23:30:00 -0400
Subject: [PATCH] fix: drop sync messages not sent by this account

Any account could send sync messages: contacts, keys, requests, sticker
packs, and sent transcripts that set disappearing timers. Signal-Android
and Signal-Desktop drop sync messages whose sender isn't the own ACI.

Assisted-by: Claude Opus 5.5
---
diff --git a/src/manager/registered.rs b/src/manager/registered.rs
index eb21fb1..9bef1d3 100644
--- a/src/manager/registered.rs
+++ b/src/manager/registered.rs
@@ -692,6 +692,15 @@ impl<S: Store> Manager<S, Registered> {
                             };
                             match envelope {
                                 Ok(Some(content)) => {
+                                    // only our own devices may send sync messages
+                                    if matches!(content.body, ContentBody::SynchronizeMessage(_))
+                                        && content.metadata.sender
+                                            != ServiceId::Aci(state.service_ids.aci())
+                                    {
+                                        warn!("dropping sync message not sent by this account");
+                                        continue;
+                                    }
+
                                     if let ContentBody::DecryptionErrorMessage(request) =
                                         &content.body
                                     {
